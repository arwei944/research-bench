# bench 环境变量（复制为 .env 后填入；.env 不入库）

# ---- 可选：Epoch AI 官方 API ----
# 不配置时该通道返回 401，其余 13 个通道不受影响。
# 申请：https://epoch.ai
EPOCH_API_KEY=

# ---- 可选：GitHub token（提升 API 速率上限）----
# 未配置时 GitHub 搜索限 60 次/小时。
GITHUB_TOKEN=

# ---- 可选：LLM 接入（labset 实验器 / research 报告 / learn 教练）----
# 默认指向本地 magpie 中转，一般不用改。
BENCH_LLM_BASE_URL=http://127.0.0.1:3425/v1
BENCH_LLM_API_KEY=magpie
BENCH_LLM_MODEL=auto/qfmodel
BENCH_LLM_TIMEOUT_MS=120000

# ---- 可选：服务端口与绑定地址 ----
BENCH_PORT=7800
BENCH_HOST=127.0.0.1
